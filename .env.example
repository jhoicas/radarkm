# Root example — copy to .env locally. NEVER commit real secrets.

# API
RADARKM_API_ADDR=:8080
RADARKM_DATABASE_URL=postgres://radarkm:radarkm@localhost:5432/radarkm?sslmode=disable
RADARKM_REDIS_URL=redis://localhost:6379/0
RADARKM_ED25519_PRIVATE_KEY_PEM=
RADARKM_ED25519_PUBLIC_KEY_PEM=
RADARKM_PLAY_INTEGRITY_PACKAGE_NAME=com.radarkm.app

# Admin Web
NEXT_PUBLIC_RADARKM_API_BASE_URL=http://localhost:8080
