<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
          CRITICAL: Do NOT set android:isAccessibilityTool="true"
          (Play policy / .agents/rules/android-security-play.md).
        -->
        <service
            android:name=".RadarKmAccessibilityService"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/radarkm_accessibility_config" />
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="RadarKm local trip offer capture" />
        </service>
    </application>
</manifest>
