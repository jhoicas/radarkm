RADARKM_API_ADDR=:8080
RADARKM_DATABASE_URL=postgres://radarkm:radarkm@localhost:5432/radarkm?sslmode=disable
RADARKM_REDIS_URL=redis://localhost:6379/0
RADARKM_MIGRATIONS_DIR=migrations

# Ed25519 signing (never commit real keys). Prefer PEM or raw seed/private key as base64.
RADARKM_ED25519_PRIVATE_KEY_PEM=
RADARKM_ED25519_PRIVATE_KEY_B64=
RADARKM_ED25519_PUBLIC_KEY_PEM=
RADARKM_ED25519_KEY_ID=default

# Play Integrity
RADARKM_PLAY_INTEGRITY_PACKAGE_NAME=com.radarkm.app

# Optional PEM bundle of Android Key Attestation trust roots for production wiring.
RADARKM_KEY_ATTESTATION_ROOTS_PEM=

